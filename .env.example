# Archivo de ejemplo de Variables de Entorno (Environment Variables)
# Instrucciones:
# 1. Copia este archivo y renómbralo a '.env'
# 2. Reemplaza los valores con contraseñas seguras y largas
# 3. NUNCA subas el archivo '.env' a GitHub

# Configuración de Base de Datos PostgreSQL
DB_USER=admin
DB_PASSWORD=una_contraseña_super_segura_aqui
DB_NAME=sigadb

# Configuración de Seguridad JWT (JSON Web Tokens)
# Genera un string largo y aleatorio para esto
JWT_SECRET=reemplaza_esto_por_un_hash_largo_y_aleatorio_en_produccion
